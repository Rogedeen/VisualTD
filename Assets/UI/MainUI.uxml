<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="MainUI.uss" />
    <ui:VisualElement name="TopContainer" style="position: absolute; top: 10px; left: 10px; right: 10px; flex-direction: row; justify-content: space-between;">
        <ui:VisualElement name="EconomyPanel" class="glass-panel">
            <ui:Label text="GOLD" style="font-size: 12px; color: rgb(200, 200, 200);" />
            <ui:Label name="GoldText" text="0" class="resource-text" />
        </ui:VisualElement>
        
        <ui:VisualElement style="flex-direction: row; gap: 10px;">
            <ui:VisualElement name="GateHealthPanel" class="glass-panel">
                <ui:Label text="GATE HEALTH" style="font-size: 12px; color: rgb(200, 200, 200);" />
                <ui:Label name="HealthText" text="1000" class="health-text" />
            </ui:VisualElement>
            
            <ui:VisualElement name="PlayerHealthPanel" class="glass-panel">
                <ui:Label text="PLAYER HEALTH" style="font-size: 12px; color: rgb(200, 200, 200);" />
                <ui:Label name="PlayerHealthText" text="20" class="health-text" style="color: rgb(0, 255, 100);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="GesturePanel" class="gesture-panel">
        <ui:Label text="DETECTED GESTURE" class="gesture-label" />
        <ui:Label name="GestureText" text="None" class="gesture-value" />
    </ui:VisualElement>

    <ui:VisualElement name="SkillContainer" class="skill-container">
        <ui:VisualElement name="Skill_Arrow" class="skill-slot">
            <ui:VisualElement name="Icon_Arrow" class="skill-icon" style="background-image: none;" />
            <ui:VisualElement name="CooldownBar_Arrow" class="skill-cooldown-overlay" />
            <ui:Label text="ARROW VOLLEY" class="skill-label" />
        </ui:VisualElement>

        <ui:VisualElement name="Skill_Lightning" class="skill-slot">
            <ui:VisualElement name="Icon_Lightning" class="skill-icon" style="background-image: none;" />
            <ui:VisualElement name="CooldownBar_Lightning" class="skill-cooldown-overlay" />
            <ui:Label text="LIGHTNING" class="skill-label" />
        </ui:VisualElement>

        <ui:VisualElement name="Skill_Fortify" class="skill-slot">
            <ui:VisualElement name="Icon_Fortify" class="skill-icon" style="background-image: none;" />
            <ui:VisualElement name="CooldownBar_Fortify" class="skill-cooldown-overlay" />
            <ui:Label text="FORTIFY" class="skill-label" />
        </ui:VisualElement>

        <ui:VisualElement name="Skill_Meteor" class="skill-slot">
            <ui:VisualElement name="Icon_Meteor" class="skill-icon" style="background-image: none;" />
            <ui:VisualElement name="CooldownBar_Meteor" class="skill-cooldown-overlay" />
            <ui:Label text="METEOR RAIN" class="skill-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>