/* Menu Shared Styles */
:root {
    --color-gold: #D4AF37;
    --color-gold-bright: #FFD700;
    --color-slate: #1A1C23;
    --color-parchment: #F1E9D2;
    --panel-bg: rgba(10, 12, 18, 0.98);
}

.menu-container {
    position: absolute;
    top: 0;
    left: 0;
    flex-grow: 1;
    background-color: var(--panel-bg);
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
}

.menu-panel {
    width: 500px;
    padding: 60px;
    background-color: rgba(30, 32, 40, 0.95);
    border-width: 4px;
    border-color: var(--color-gold);
    border-radius: 20px;
    align-items: center;
}

.menu-title {
    font-size: 64px;
    color: var(--color-gold-bright);
    -unity-font-style: bold;
    margin-bottom: 40px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
}

.menu-button {
    width: 320px;
    height: 64px;
    background-color: var(--color-gold);
    border-radius: 10px;
    color: var(--color-slate);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    border-width: 0;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.menu-button:hover {
    scale: 1.05;
    background-color: var(--color-gold-bright);
}

.menu-button:active {
    scale: 0.95;
}

.quit-button {
    background-color: #444;
    color: white;
}

.quit-button:hover {
    background-color: #666;
}

.menu-subtitle {
    font-size: 20px;
    color: #AAA;
    margin-bottom: 20px;
}

.win-text {
    color: #44FF44;
}

.loss-text {
    color: #FF4444;
}
