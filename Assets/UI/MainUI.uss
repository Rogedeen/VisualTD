.glass-panel {
    background-color: rgba(15, 20, 30, 0.85);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 12px 24px;
    margin: 16px;
    min-width: 150px;
}

.resource-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 215, 0); /* Gold color */
}

.health-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 60, 60); /* Red color */
}

.gesture-panel {
    position: absolute;
    bottom: 40px;
    align-self: center;
    align-items: center;
    background-color: rgba(10, 15, 25, 0.95);
    border-radius: 20px;
    padding: 16px 32px;
    border-top-width: 3px;
    border-top-color: rgb(46, 163, 255);
}

.gesture-label {
    font-size: 14px;
    color: rgb(160, 196, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.gesture-value {
    font-size: 42px;
    -unity-font-style: bold;
    color: white;
}

/* SKILL UI STYLES */
.skill-container {
    position: absolute;
    right: 40px;
    top: 55%;
    translate: 0 -50%;
    flex-direction: column;
}

.skill-slot {
    align-items: center;
    margin-bottom: 25px;
    width: 90px;
}

.skill-icon {
    width: 70px;
    height: 70px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 35px;
    border-width: 5px;
    border-color: rgb(255, 0, 0); /* Default to red (cooling) */
    margin-bottom: 8px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition-property: scale, border-color;
    transition-duration: 0.3s, 0.2s;
}

.skill-label {
    font-size: 11px;
    color: rgb(220, 220, 220);
    -unity-font-style: bold;
    -unity-text-align: center;
    letter-spacing: 1px;
}

.skill-ready {
    border-color: rgb(0, 255, 100);
    scale: 1.1;
}

.skill-cooldown-overlay {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.7);
    width: 100%;
    bottom: 0;
    height: 100%; /* Will be animated in C# */
}

/* Animations */
.pulse-animation {
    scale: 1.2;
}