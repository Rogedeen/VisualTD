/* Fantasy Theme Colors */
:root {
    --color-gold: #D4AF37;
    --color-gold-bright: #FFD700;
    --color-slate: #1A1C23;
    --color-parchment: #F1E9D2;
    --color-arcane: #4A90E2;
    --color-crimson: #B22222;
    --panel-bg: rgba(20, 22, 28, 0.92);
}

/* TOP RESOURCE PANELS */
.fantasy-panel {
    background-color: var(--panel-bg);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--color-gold);
    padding: 10px 20px;
    min-width: 140px;
    border-bottom-width: 4px; 
}

.panel-header {
    font-size: 11px;
    color: #AAA;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.resource-gold {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
}

.resource-gold-suffix {
    font-size: 18px;
    color: var(--color-gold);
    margin-left: 4px;
    margin-top: 8px;
}

.resource-health {
    font-size: 32px;
    -unity-font-style: bold;
    color: #FF4444;
}

.panel-highlight-red {
    border-color: var(--color-crimson);
}

/* GESTURE FEEDBACK (BOTTOM CENTER) */
.gesture-panel {
    position: absolute;
    bottom: 50px;
    align-self: center;
    background-color: rgba(10, 12, 18, 0.95);
    border-width: 2px;
    border-color: var(--color-arcane);
    border-radius: 40px;
    padding: 12px 40px;
    align-items: center;
    transition-property: scale;
    transition-duration: 0.1s;
}

.gesture-header {
    font-size: 10px;
    color: var(--color-arcane);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.gesture-value {
    font-size: 38px;
    -unity-font-style: bold;
    color: white;
}

/* UPGRADE DECK (BOTTOM HORIZONTAL) */
.upgrade-bar {
    position: absolute;
    bottom: 30px;
    left: 40px;
    flex-direction: row;
    gap: 15px;
}

.upgrade-card {
    background-color: var(--panel-bg);
    border-width: 2px;
    border-color: #444;
    border-radius: 6px;
    padding: 8px;
    width: 90px;
    align-items: center;
    transition-property: scale, border-color, translate;
    transition-duration: 0.2s;
}

.upgrade-frame {
    width: 50px;
    height: 50px;
    background-color: #000;
    border-radius: 4px;
    border-width: 1px;
    border-color: #555;
    margin-bottom: 6px;
}

.card-label {
    font-size: 10px;
    color: #DDD;
    -unity-font-style: bold;
    -unity-text-align: center;
}

.card-cost {
    font-size: 12px;
    color: var(--color-gold-bright);
    -unity-font-style: bold;
}

.ready-to-buy {
    border-color: var(--color-gold-bright);
    scale: 1.05;
}

/* SKILL ORBS (RIGHT VERTICAL) */
.skill-dock {
    position: absolute;
    right: 30px;
    top: 50%;
    translate: 0 -50%;
    gap: 20px;
}

.skill-orb {
    width: 84px;
    height: 84px;
    background-color: #000;
    border-radius: 42px;
    border-width: 4px;
    border-color: #880000;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition-property: scale, border-color;
    transition-duration: 0.2s;
}

.orb-inner {
    width: 70px;
    height: 70px;
    border-radius: 35px;
    background-color: rgba(255,255,255,0.05);
}

.orb-wipe {
    position: absolute;
    background-color: rgba(0,0,0,0.75);
    width: 100%;
    bottom: 0;
    height: 100%;
}

.orb-label {
    position: absolute;
    bottom: -18px;
    font-size: 10px;
    color: #AAA;
    -unity-font-style: bold;
}

.skill-ready {
    border-color: var(--color-gold-bright);
    scale: 1.1;
}

.pulse {
    scale: 1.2;
}
